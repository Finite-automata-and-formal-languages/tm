cabal-version:      3.4
name:               tm
version:            0.1.0.0
license:            AGPL-3.0-or-later
license-file:       LICENSE
author:             Naïm Camille Favier
maintainer:         n@monade.li
category:           Math
build-type:         Simple

executable tm
    hs-source-dirs:   src
    default-language: GHC2021
    other-modules:
        TM,
    default-extensions:
        BlockArguments,
        OverloadedStrings,
        RecordWildCards,
    build-depends:
        base,
        containers,
        megaparsec,
        mtl,
        text,
        turing,
    if arch(javascript)
        main-is: MainJS.hs
        cpp-options: -DGHCJS_BROWSER
        -- https://gitlab.haskell.org/ghc/ghc/-/merge_requests/14362
        ld-options: -sEXPORTED_RUNTIME_METHODS=HEAP8,HEAPU8
    else
        main-is: Main.hs
